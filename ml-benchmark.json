{
  "schema": "public-secure-ml-v1",
  "dataset": "sklearn Iris classes 0 and 1",
  "train_samples": 64,
  "test_samples": 36,
  "features": 4,
  "split_seed": 20260912,
  "preprocessing": "train-only median/IQR, clip [-3,3], divide by 3",
  "epochs": 20,
  "batch_size": 64,
  "learning_rate": 0.5,
