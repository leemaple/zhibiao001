  "l2_lambda": 0.01,
  "fraction_bits": 16,
  "value_bits": 31,
  "ring_bits": 64,
  "round_nearest": true,
  "logistic_sigmoid": "upstream MP-SPDZ approx_sigmoid(n=5)",
  "svm": "linear soft-margin hinge; L2 weights, unregularized bias",
  "repetitions": 3,
  "max_abs_weight_error": 0.001,
  "max_abs_score_error": 0.001,
  "minimum_class_agreement": 1.0,
  "timeout_seconds": 300,
  "scope": "Public-data functional baseline; no production security or acceptance claim"
}
